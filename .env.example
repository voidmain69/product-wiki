# ── Copy to .env and adjust ──────────────────────────────────────────────
NODE_ENV=development

# Host-порти інфраструктури (docker-compose). Зсувай лише за конфлікту з іншим
# локальним стеком; тоді синхронно онови *_URL нижче.
POSTGRES_PORT=5432
NATS_PORT=4222
NATS_MONITOR_PORT=8222
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
REDIS_PORT=6379
S3_PORT=9000
S3_CONSOLE_PORT=9001

# Postgres (canonical data)
DATABASE_URL=postgres://wiki:wiki@localhost:5432/wiki

# NATS JetStream (event bus)
NATS_URL=nats://localhost:4222

# Qdrant (vector DB)
QDRANT_URL=http://localhost:6333

# Redis (sessions, rate-limit, dedup)
REDIS_URL=redis://localhost:6379

# MinIO / S3 (immutable raw snapshots)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_SNAPSHOTS=snapshots

# ML inference service (embeddings + rerank, gRPC)
ML_GRPC_URL=localhost:50051

# LLM provider abstraction: "local" (vLLM/ollama) | "anthropic" | "openai-compatible"
# LLM_DEV_MODE=1 → детермінований провайдер без реальної моделі (локальний E2E/CI)
LLM_PROVIDER=local
LLM_DEV_MODE=0
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5-14b-instruct

# ML inference: ML_DEV_MODE=1 → лексичні ембединги без torch (локальний E2E/CI)
ML_DEV_MODE=0

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
