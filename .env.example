# ── Copy to .env and adjust ──────────────────────────────────────────────
NODE_ENV=development

# Postgres (canonical data)
DATABASE_URL=postgres://wiki:wiki@localhost:5432/wiki

# NATS JetStream (event bus)
NATS_URL=nats://localhost:4222

# Qdrant (vector DB)
QDRANT_URL=http://localhost:6333

# Redis (sessions, rate-limit, dedup)
REDIS_URL=redis://localhost:6379

# MinIO / S3 (immutable raw snapshots)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_SNAPSHOTS=snapshots

# ML inference service (embeddings + rerank, gRPC)
ML_GRPC_URL=localhost:50051

# LLM provider abstraction: "local" (vLLM/ollama) | "anthropic" | "openai-compatible"
LLM_PROVIDER=local
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=
LLM_MODEL=qwen2.5-14b-instruct

# API
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
