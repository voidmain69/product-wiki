{
  "name": "product-wiki",
  "version": "0.1.0",
  "private": true,
  "description": "Вікіпедія товарів — некомерційний RAG-сервіс достовірної інформації про товари",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,mjs,json,md,yml}\"",
    "check:arch": "node scripts/check-arch.mjs",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "turbo run clean && rimraf node_modules",
    "infra:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/docker/docker-compose.yml logs -f",
    "db:generate": "pnpm --filter @wiki/db generate",
    "db:migrate": "pnpm --filter @wiki/db migrate",
    "db:seed": "pnpm --filter @wiki/db seed",
    "smoke:ingest": "tsx scripts/smoke-ingest.ts",
    "smoke:real": "tsx scripts/smoke-real.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/node": "^22.7.0",
    "@wiki/chat-orchestrator": "workspace:*",
    "@wiki/contracts": "workspace:*",
    "@wiki/db": "workspace:*",
    "@wiki/events": "workspace:*",
    "@wiki/llm": "workspace:*",
    "@wiki/retrieval": "workspace:*",
    "eslint": "^9.14.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "tsx": "^4.23.1",
    "turbo": "^2.10.5",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.64.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "vite@<6.4.3": "^6.4.3",
      "esbuild@<0.25.0": "^0.25.0",
      "postcss@<8.5.10": "^8.5.10"
    }
  }
}
